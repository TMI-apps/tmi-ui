{
  "name": "@tmi-apps/ui",
  "version": "0.4.0",
  "description": "Shared React + MUI UI primitives for TMI apps (ThumbnailPill, VideoEmbedModal, PersistentStepperList).",
  "keywords": [
    "tmi",
    "react",
    "mui",
    "material-ui",
    "emotion",
    "thumbnail",
    "video",
    "youtube",
    "vimeo"
  ],
  "author": "TMI Apps",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/TMI-apps/tmi-ui.git"
  },
  "bugs": {
    "url": "https://github.com/TMI-apps/tmi-ui/issues"
  },
  "homepage": "https://github.com/TMI-apps/tmi-ui#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "verify:pack": "node ./scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "typescript": "^5.6.3"
  }
}

{
  "name": "@tmi-packages/ui",
  "version": "1.4.0",
  "description": "Shared React + MUI UI primitives (ThumbnailPill, VideoEmbedModal, PersistentStepperList, TMI table satellites and workspace).",
  "keywords": [
    "tmi",
    "react",
    "mui",
    "material-ui",
    "emotion",
    "thumbnail",
    "video",
    "youtube",
    "vimeo",
    "checklist"
  ],
  "author": "TMI Publishing B.V.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TMI-apps/tmi-ui.git"
  },
  "bugs": {
    "url": "https://github.com/TMI-apps/tmi-ui/issues"
  },
  "homepage": "https://github.com/TMI-apps/tmi-ui#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/assert-dist-esm-imports.mjs",
    "prepare": "tsc -p tsconfig.build.json && node ./scripts/assert-dist-esm-imports.mjs",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "type-check:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"docs/**/*.md\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"docs/**/*.md\" \"*.{json,md}\"",
    "verify:pack": "node ./scripts/verify-pack.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install",
    "publish:npm": "pnpm run build && pnpm publish --no-git-checks"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.13.24",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.2",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.13.24",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
